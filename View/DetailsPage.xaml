<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="homeapp.View.DetailsPage"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <Image Aspect="AspectFill" Source="{Binding SelectedProperty.DefaultImage}" />

        <Grid RowDefinitions="*,Auto">
            <VerticalStackLayout HorizontalOptions="End" Margin="0,40,20,0">
                <Grid x:Name="imagesView" WidthRequest="90" VerticalOptions="Start" HorizontalOptions="End" Margin="0,0,0,20">
                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30" Padding="8">
                        <CollectionView ItemsSource="{Binding HomeImages}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" StrokeThickness="0" StrokeShape="RoundRectangle 30" Margin="0,0,0,8">
                                        <Image Aspect="AspectFill" Source="{Binding .}" WidthRequest="60" HeightRequest="60" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.Footer>
                                <Border WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" BackgroundColor="#4C65FF" StrokeThickness="0" StrokeShape="RoundRectangle 30" Margin="0,0,0,8">
                                    <Label Text="{Binding MoreItems, StringFormat='+ {0}'}" FontSize="24" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </CollectionView.Footer>
                        </CollectionView>
                    </Border>
                </Grid>

                <Grid x:Name="detailsBtn" HorizontalOptions="End">
                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30" Padding="16">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="dotnet_bot.png" WidthRequest="30" HeightRequest="30" />
                            <Label Text="Details" FontSize="18" TextColor="Black" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <Grid x:Name="popView" Grid.Row="1">
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30,30,0,0" Padding="24">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout x:Name="addressView">
                            <Label Text="{Binding SelectedProperty.Address}" FontSize="20" Opacity="0.7" TextColor="Black" />
                            <Label Text="{Binding SelectedProperty.Price, StringFormat='Price: {0:###,###}'}" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                        </VerticalStackLayout>

                        <Button x:Name="buyBtn"
                                Text="Buy Now"
                                BackgroundColor="#4C65FF"
                                TextColor="White"
                                CornerRadius="24"
                                HeightRequest="50"
                                Clicked="OnContactAgentClicked"
                                HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
