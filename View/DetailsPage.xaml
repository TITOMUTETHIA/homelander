<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="homeapp.View.DetailsPage"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <Image Aspect="AspectFill" Source="{Binding SelectedProperty.DefaultImage}" />
        <Grid RowDefinitions="*,Auto">
            <VerticalStackLayout x:Name="SideView">
                <Grid x:Name="imagesView" WidthRequest="90" HorizontalOptions="End" Margin="0,80,20,0">
                    <Border BackgroundColor="White" Opacity="0.9" StrokeThickness="0" StrokeShape="RoundRectangle 40">
                        <CollectionView Margin="0,10" ItemsSource="{Binding HomeImages}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="60" HeightRequest="60" Margin="0,0,0,10" HorizontalOptions="Center" StrokeShape="RoundRectangle 30" StrokeThickness="0">
                                        <Image Aspect="AspectFill" Source="{Binding .}" WidthRequest="60" HeightRequest="60" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.Footer>
                                <Border WidthRequest="60" HeightRequest="60" Margin="0,0,0,10" BackgroundColor="#4C65FF" StrokeShape="RoundRectangle 30" StrokeThickness="0" HorizontalOptions="Center">
                                    <Label Text="{Binding MoreItems, StringFormat='+ {0}'}" FontSize="20" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </CollectionView.Footer>
                        </CollectionView>
                    </Border>
                </Grid>

                <Grid x:Name="detailsBtn" HorizontalOptions="End" Margin="0,60,20,0">
                    <Border BackgroundColor="White" Opacity="0.9" StrokeThickness="0" StrokeShape="RoundRectangle 60" WidthRequest="115" HeightRequest="115">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="arrow.png" WidthRequest="30" HeightRequest="30" />
                            <Label Text="Details" FontSize="20" TextColor="Black" Opacity="0.5" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <Grid x:Name="popView" Grid.Row="1">
                <Border BackgroundColor="White" Opacity="0.9" StrokeThickness="0" StrokeShape="RoundRectangle 35,35,0,0" HorizontalOptions="Fill">
                    <Grid Padding="30">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout x:Name="addressView">
                                <Label Text="{Binding SelectedProperty.Address}" FontSize="20" Opacity="0.5" TextColor="Black" />
                                <Label Text="{Binding SelectedProperty.Price, StringFormat='Price: {0:###,###}'}" FontSize="Body" FontAttributes="Bold" TextColor="Black" />
                            </VerticalStackLayout>
                            <Button x:Name="buyBtn" Text="Buy Now" BackgroundColor="#4C65FF" TextColor="White" FontSize="18" CornerRadius="25" HeightRequest="50" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
