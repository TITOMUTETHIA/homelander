<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="homeapp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:homeapp.View"
    Title="Home App">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:LandingPage}"
            Route="landing" />

        <ShellContent
            Title="Admin"
            ContentTemplate="{DataTemplate local:AdminDashboard}"
            Route="admin" />
    </TabBar>

</Shell>
